{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/inject-plan-context.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/cargo-fmt-check.sh",
        "matcher": "Write"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-test-network.sh",
        "matcher": "cargo\\s+(test|nextest)"
      }
    ]
  }
}
